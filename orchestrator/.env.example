# Copy to .env (gitignored) and fill in.

# The agent's model. ORCH_PROVIDER is openai or xai (Grok); anthropic also
# works with langchain-anthropic installed. Only the chosen provider's key is
# needed, plus OPENAI_API_KEY if you want vector search in the phrase memory.
# A blank ORCH_MODEL uses the provider's default: gpt-6-astra or grok-4.7.
OPENAI_API_KEY=
XAI_API_KEY=
ORCH_PROVIDER=openai
ORCH_MODEL=

# The vision model used for event turns and for /describe answers. It has to
# accept images. Leave blank to reuse ORCH_MODEL.
ORCH_VISION_MODEL=

# Embeddings for the phrase memory, always OpenAI's. Blank (or no
# OPENAI_API_KEY) disables vector search and the memory falls back to
# full-text, which needs no network — the right setting for an offline venue.
ORCH_EMBED_MODEL=text-embedding-3-small

# Where perception lives.
PERCEPTION_BASE=http://localhost:8001

PORT=8000
LOG_LEVEL=INFO

# Wake the agent at most once per behaviour per this many seconds.
ORCH_EVENT_COOLDOWN_S=5.0
# Hard cap on tool calls in one turn.
ORCH_MAX_STEPS=10
# Whole-turn deadline; frontend REQUEST_TIMEOUT_MS must allow extra HTTP time.
ORCH_TURN_TIMEOUT_S=180
