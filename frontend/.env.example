# Copy to .env.local (gitignored).
#
# Service URLs only. No secrets live in the browser — the LLM and its API key
# are the orchestrator's, in orchestrator/.env.

VITE_ORCHESTRATOR_URL=http://localhost:8000
VITE_PERCEPTION_URL=http://localhost:8001

# Defaults to {VITE_PERCEPTION_URL}/video. Set it to point the pane at a phone
# IP-cam or a second machine.
# VITE_VIDEO_URL=

# Optional: route calls through the Vite dev server instead of hitting the
# services directly. Only needed when a service is reachable but CORS is not.
# Set these, then point the URLs above at /perception and /orchestrator.
# PROXY_PERCEPTION=http://localhost:8001
# PROXY_ORCHESTRATOR=http://localhost:8000
